# ============================================================
# LEARNABLE / SAIS — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must NEVER be committed.
# ============================================================

# ----------------------------------------------------------
# PostgreSQL Connection
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5432/learnable

# ----------------------------------------------------------
# Security
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
SECRET_KEY=sais-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
DEBUG=True
APP_NAME=Student Academic Intelligence System
APP_VERSION=1.0.0
UPLOAD_DIR=uploads

# ----------------------------------------------------------
# Supabase Auth / OAuth
# ----------------------------------------------------------
SUPABASE_URL=https://hdgiwttadphvqxjnazmi.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret-if-local-jwt-verification-is-enabled>
SUPABASE_OAUTH_REDIRECT_URL=https://<render-service>.onrender.com/

# Frontend build-time variables
VITE_SUPABASE_URL=https://hdgiwttadphvqxjnazmi.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
VITE_API_URL=
